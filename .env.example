# ═══════════════════════════════════════════════════════════════════
#  CF Command Center — environment
#  Copy this file to `.env` and fill in your READ-ONLY token.
#  See docs/TOKEN-SETUP.md for exact scopes + step-by-step creation.
#  NEVER commit .env — it is gitignored.
# ═══════════════════════════════════════════════════════════════════

# Read-only token. Used by default for ALL snapshots, reports, and diffs.
# Create from the "Read all resources" template (fast) or a custom read token.
CF_READ_TOKEN=

# Optional: pin the account id so scripts don't have to guess.
# Find it with: npm run snapshot (it prints/saves the account on first run),
# or in the Cloudflare dashboard URL.
CF_ACCOUNT_ID=

# Keys the pseudonymization that produces the committed snapshot.public.json
# (scripts/lib/idmap.mjs) from the local-only raw snapshot.json. Auto-generated
# and appended here on first `npm run snapshot` if left blank — you don't need
# to set this by hand. Back it up alongside secrets/alias-map.json: together
# they're what lets you reverse a committed alias back to a real value.
CF_ALIAS_SALT=

# Optional operator addresses used by social-desk-provision.mjs.
# Keep real addresses only in your local .env.
SOCIAL_DESK_ALLOWED_EMAILS=

# ─── BREAK-GLASS (destructive actions) ──────────────────────────────
# The EDIT token does NOT belong here. Put it in a SEPARATE file
# `.env.break-glass` (also gitignored) so routine runs can never load it.
# Actions additionally require: CF_ALLOW_DESTRUCTIVE=YES_I_AM_SURE
# See docs/SAFETY.md.
