{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(node scripts/snapshot.mjs:*)",
      "Bash(node scripts/report.mjs:*)",
      "Bash(node scripts/diff.mjs:*)",
      "Bash(node scripts/betas.mjs:*)",
      "Bash(node scripts/build-dashboard-data.mjs:*)",
      "Bash(node scripts/setup.mjs:*)",
      "Bash(npm run snapshot:*)",
      "Bash(npm run report:*)",
      "Bash(npm run diff:*)",
      "Bash(npm run betas:*)",
      "Bash(npm run build-data:*)",
      "Bash(npm run refresh:*)",
      "Bash(npm run setup:*)",
      "Bash(npm run dashboard:*)",
      "Bash(npm run dashboard:build:*)",
      "Bash(npm --prefix dashboard:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "mcp__cloudflare-bindings__workers_list",
      "mcp__cloudflare-bindings__workers_get_worker",
      "mcp__cloudflare-bindings__workers_get_worker_code",
      "mcp__cloudflare-bindings__kv_namespaces_list",
      "mcp__cloudflare-bindings__kv_namespace_get",
      "mcp__cloudflare-bindings__r2_buckets_list",
      "mcp__cloudflare-bindings__r2_bucket_get",
      "mcp__cloudflare-bindings__d1_databases_list",
      "mcp__cloudflare-bindings__d1_database_get",
      "mcp__cloudflare-bindings__hyperdrive_configs_list",
      "mcp__cloudflare-bindings__hyperdrive_config_get",
      "mcp__cloudflare-bindings__search_cloudflare_documentation",
      "mcp__cloudflare-docs__search_cloudflare_documentation",
      "mcp__cloudflare-docs__migrate_pages_to_workers_guide",
      "mcp__cloudflare-builds__workers_list",
      "mcp__cloudflare-builds__workers_get_worker",
      "mcp__cloudflare-builds__workers_get_worker_code",
      "mcp__cloudflare-builds__workers_builds_list_builds",
      "mcp__cloudflare-builds__workers_builds_get_build",
      "mcp__cloudflare-builds__workers_builds_get_build_logs",
      "mcp__cloudflare-builds__workers_builds_set_active_worker",
      "mcp__cloudflare__docs",
      "mcp__cloudflare__search"
    ],
    "ask": [
      "Bash(node scripts/actions/:*)",
      "Bash(npm run action:*)",
      "Bash(node scripts/sanitize.mjs:*)",
      "Bash(npm run sanitize:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh repo create:*)",
      "Bash(curl:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(Invoke-WebRequest:*)",
      "mcp__cloudflare-bindings__kv_namespace_create",
      "mcp__cloudflare-bindings__kv_namespace_update",
      "mcp__cloudflare-bindings__kv_namespace_delete",
      "mcp__cloudflare-bindings__r2_bucket_create",
      "mcp__cloudflare-bindings__r2_bucket_delete",
      "mcp__cloudflare-bindings__d1_database_create",
      "mcp__cloudflare-bindings__d1_database_delete",
      "mcp__cloudflare-bindings__d1_database_query",
      "mcp__cloudflare-bindings__hyperdrive_config_create",
      "mcp__cloudflare-bindings__hyperdrive_config_edit",
      "mcp__cloudflare-bindings__hyperdrive_config_delete",
      "mcp__cloudflare__execute"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__cloudflare__execute",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs"
          }
        ]
      }
    ]
  }
}
