# Cloudflare Maxxing read-only configuration.
# This file lives under <host-project>/.cloudflare-maxxing/ and never uses the
# host project's generic .env.

# Create from Cloudflare's "Read all resources" API-token template.
CF_READ_TOKEN=

# Optional when the token can see more than one account.
CF_ACCOUNT_ID=

# Generated automatically on the first snapshot. Back it up with
# secrets/alias-map.json if you need reversible pseudonyms.
CF_ALIAS_SALT=
